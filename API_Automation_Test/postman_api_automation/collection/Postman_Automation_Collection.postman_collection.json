{
	"info": {
		"_postman_id": "65199cad-0a59-4fe0-9144-db7b20d7306f",
		"name": "Postman_Automation_Collection",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "17215032"
	},
	"item": [
		{
			"name": "Get_Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test Case 1: The Response Code should be HTTP 200 \r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Test Case 2: Response time should be less than 100 miliseconds\r",
							"const expectedResponsTime = Number(pm.environment.get(\"responseTimeLimit\")); // Postman stores environment variables as string by default\r",
							"\r",
							"pm.test(\"Response time is less than \" + expectedResponsTime + \"ms\", function () {\r",
							"    const actualResponseTime = pm.response.responseTime;\r",
							"    pm.expect(actualResponseTime).to.be.below(expectedResponsTime);\r",
							"});\r",
							"\r",
							"// Test Case 3: Basic Contact Validation  \r",
							"const jsonResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Basic contact validation\", function () {\r",
							"    pm.expect(jsonResponse).to.have.property(\"page\");\r",
							"    pm.expect(jsonResponse).to.have.property(\"per_page\");\r",
							"    pm.expect(jsonResponse).to.have.property(\"total\");\r",
							"    pm.expect(jsonResponse).to.have.property(\"total_pages\");\r",
							"    pm.expect(jsonResponse).to.have.property(\"data\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseURL}}/users?page=2",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"users"
					],
					"query": [
						{
							"key": "page",
							"value": "2"
						}
					]
				}
			},
			"response": []
		}
	]
}